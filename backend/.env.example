# Core
DATABASE_URL=sqlite:///./interpay.db
# For Postgres use: postgresql+psycopg://user:pass@localhost:5432/interpay
SECRET_KEY=change-this-to-a-long-random-string
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
APP_SCHEME=interpay

# Seeded admin account (created on first start)
ADMIN_EMAIL=admin@interpay.app
ADMIN_PASSWORD=change-me-now

# Payments: simulated | interswitch
PAYMENT_GATEWAY=simulated
IPG_MODE=TEST
# Copy the merchant code and pay item id from the credentials shared by the organisers
IPG_MERCHANT_CODE=
IPG_PAY_ITEM_ID=
# Confirm the verify endpoint in the Interswitch documentation, override here if needed
# IPG_VERIFY_URL=

# Payouts: simulated (the real adapter needs transfer API access)
PAYOUT_PROVIDER=simulated
PLATFORM_FEE_PERCENT=3
CANCEL_WINDOW_HOURS=12
RESERVATION_MINUTES=15

# Email: console (writes .eml files to MAIL_DIR) | smtp
MAIL_MODE=console
MAIL_DIR=./mail_outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=InterPay <tickets@yourdomain.com>
